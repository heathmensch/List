# Copy into apps/pluto/.env and apps/takeoff/.env.local as noted below.

# --- Pluto API (apps/pluto/.env) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stats_platform?schema=public
PORT=4000
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# --- Takeoff web (apps/takeoff/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
