# Pluto API base URL (no trailing slash).
# Local: http://localhost:4000
# Vercel (Takeoff project): https://<your-pluto-deployment>.vercel.app
NEXT_PUBLIC_API_URL=http://localhost:4000

# Clerk (from dashboard.clerk.com — clerk init writes keys to .env.local)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
