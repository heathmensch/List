# Local Pluto only. On Vercel, leave this unset: the browser calls /api
# and server code reads PLUTO_URL from the takeoff → pluto binding.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Clerk (from dashboard.clerk.com — clerk init writes keys to .env.local)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
