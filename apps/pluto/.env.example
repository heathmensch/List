# Supabase transaction-mode pooler (IPv4). Used by the Nest API at runtime.
DATABASE_URL="postgresql://postgres.knksixuicxsyodvcegql:[YOUR-PASSWORD]@aws-0-us-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase session-mode pooler. Used by the Prisma CLI for migrations.
# Not required on Vercel at runtime unless you run migrations there.
DIRECT_URL="postgresql://postgres.knksixuicxsyodvcegql:[YOUR-PASSWORD]@aws-0-us-west-1.pooler.supabase.com:5432/postgres"

PORT=4000

# Takeoff origin(s) allowed to call this API. Comma-separated for prod + previews.
# Local: http://localhost:3000
# Vercel: https://<your-takeoff-deployment>.vercel.app
CORS_ORIGIN=http://localhost:3000

NODE_ENV=development
